[Unit]
Description=Crash reporter integration with sp-endurance

ConditionPathExists=/var/cache/core-dumps/endurance-enabled-mark

[Service]
Type=simple
EnvironmentFile=-/usr/share/crash-reporter-settings/crash-reporter-endurance.conf
ExecStart=/usr/libexec/endurance-collect-daemon $ENDURANCE_COLLECT_OPTS
Restart=always

[Install]
WantedBy=multi-user.target
